import wollok.game.*
import juego.*
import direcciones.*

 const arriba = new Arriba()
 const abajo = new Abajo()
 const derecha = new Derecha()
 const izquierda = new Izquierda() 
 
object config {
	method configurarEscenario() {
		game.title("¡boo?")
		 game.cellSize(100)
		game.height(10)
		game.width(10)
		game.boardGround("1erfondo.jpg")
	}
	method teclas() {
		keyboard.up().onPressDo({hermanos.mover(arriba)})
        keyboard.down().onPressDo({hermanos.mover(abajo)})
        keyboard.left().onPressDo({hermanos.mover(izquierda)})
        keyboard.right().onPressDo({hermanos.mover(derecha)})
		keyboard.v().onPressDo({ hermanos.responder("v") })
		keyboard.f().onPressDo({ hermanos.responder("f") })
	}
}
	
program booGame {
	config.configurarEscenario()
	config.teclas()

	game.addVisual(hermanos)
	game.addVisual(contadorDeCaramelos)
	
	game.addVisual(ladron)
	game.addVisual(arbusto)
	
	game.addVisual(ladron2)
	game.addVisual(arbusto2)

	generador.crearCarameloAleatoriamente()
	generador.crearCarameloAleatoriamente()
	generador.crearCarameloAleatoriamente()
	generador.crearArmaAleatoriamente()
	generador.crearArmaAleatoriamente()
	generador.crearArmaAleatoriamente()

	game.onCollideDo(
		hermanos,
		{ algoColisionado => algoColisionado.interactuar() }
	)
	
	game.start()
}
