import wollok.game.*
import juego.*

object config {
	method configurarEscenario() {
		game.title("¡boo?")
		 game.cellSize(100)
		game.height(10)
		game.width(10)
		game.boardGround("1erfondo.jpg")
	}
}
const preguntaAcertijo = new Pregunta(
		texto = "2 + 2 = 4",
		respuestaCorrecta = "v"
	)
	
program booGame {
	config.configurarEscenario()
	
	game.addVisualCharacter(hermanos)
	game.addVisual(contadorDeCaramelos)
	
	
	generador.crearAleatoriamente()
	generador.crearAleatoriamente()
	generador.crearAleatoriamente()
	
	game.onCollideDo(
		hermanos,
		{ algoColisionado => algoColisionado.interactuar() }
	)
	
	game.start()
}