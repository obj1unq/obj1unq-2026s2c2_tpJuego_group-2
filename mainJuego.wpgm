import wollok.game.*

import juego.*

object config {

	method configurarEscenario() {
		game.title("¡boo?")
		game.height(10)
		game.width(10)
		game.boardGround("1erfondo.jpg")
	}
}
program booGame {

	config.configurarEscenario()

	game.addVisualCharacter(hermanos)
	game.addVisual(contadorDeCaramelos)

	game.addVisual(new Caramelo(position = game.at(3, 5)))
	game.addVisual(new Caramelo(position = game.at(3, 2)))

	game.onCollideDo(hermanos, {algoColisionado => algoColisionado.interactuar()})

	game.start()
}

